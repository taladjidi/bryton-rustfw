// Defaults, then the owner's own values from Local.xcconfig (gitignored; copy Local.xcconfig.example).
BUNDLE_ID_PREFIX = invalid.example
DEVELOPMENT_TEAM =
// The saved rides show in the Files app (Documents folder).
